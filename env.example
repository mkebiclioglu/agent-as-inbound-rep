# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
COMPANY_NAME=TechPrint Solutions
COMPANY_EMAIL=sales@techprintsolutions.com

# Phone Configuration
CUSTOMER_PHONE_NUMBER=+1234567890

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Webhook Configuration
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# API protection (optional). Without it the API only answers direct requests from
# this machine; set it and send it as the X-API-Key header to call the API remotely.
# API_KEY=choose_a_long_random_value
